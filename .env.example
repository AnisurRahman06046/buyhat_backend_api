# ──────────────────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values. `.env` is gitignored.
# All variables are validated at boot (src/config/env.validation.ts) — the app
# fails fast with a descriptive error if any required value is missing/invalid.
# ──────────────────────────────────────────────────────────────────────────

# ---- App ----
NODE_ENV=development
PORT=3000
# Comma-separated allowed origins, e.g. https://buyhat.com,https://admin.buyhat.com
# In development `*` reflects the request origin. In production an explicit list
# is REQUIRED (wildcard + credentials is rejected at boot).
CORS_ORIGIN=*

# ---- Database (PostgreSQL) ----
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=app
# `true` = TLS to Postgres (required by managed providers, e.g. Render external URLs)
# DB_SSL=true

# ---- Redis (cache + BullMQ) ----
# Either a full URL (managed Redis, e.g. Upstash; rediss:// = TLS) ...
# REDIS_URL="rediss://default:<token>@<host>.upstash.io:6379"
# ... or discrete host/port/password (REDIS_URL wins when both are set):
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ---- JWT ----
# Secrets MUST be at least 32 chars. Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-access-secret-change-me-0123456789abcdef
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-0123456789abcdef
JWT_REFRESH_EXPIRES_IN=7d

# ---- Rate limiting (per window) ----
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ---- Storage (product media) ----
# Driver: `local` (disk, dev default) or `s3` (S3/MinIO-compatible).
STORAGE_DRIVER=local
# Max accepted upload size, in MB (also hard-capped at 25MB).
STORAGE_MAX_FILE_MB=10
# Local-disk driver: where files are written, and the public path they're served at.
STORAGE_LOCAL_ROOT=./storage/uploads
STORAGE_PUBLIC_URL=/uploads
# S3 driver (only used when STORAGE_DRIVER=s3). For MinIO set S3_ENDPOINT and
# S3_FORCE_PATH_STYLE=true; STORAGE_PUBLIC_URL should be the bucket/CDN base URL.
#
# Cloudflare R2 example:
#   STORAGE_DRIVER=s3
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_BUCKET=buyhat-media
#   S3_ACCESS_KEY=<r2-access-key-id>
#   S3_SECRET_KEY=<r2-secret-access-key>
#   S3_FORCE_PATH_STYLE=true
#   STORAGE_PUBLIC_URL=https://pub-<hash>.r2.dev   # bucket's Public Development URL (or custom domain)
#
# Cloudinary driver (only used when STORAGE_DRIVER=cloudinary). Free tier,
# no card; delivery URLs auto-optimize (f_auto,q_auto) via Cloudinary's CDN.
#   STORAGE_DRIVER=cloudinary
#   CLOUDINARY_CLOUD_NAME=<cloud name from dashboard>
#   CLOUDINARY_API_KEY=<api key>
#   CLOUDINARY_API_SECRET=<api secret>
#
# S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# S3_BUCKET=buyhat-media
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false

# ---- Catalog ----
# Max variants a single generation request may create (D10 guard).
CATALOG_MAX_VARIANTS_PER_GENERATION=200

# ---- Inventory ----
# How long a stock reservation is held before expiry releases it (minutes).
INVENTORY_RESERVATION_TTL_MIN=15

# ---- Cart ----
# Inactivity before a cart is marked ABANDONED (minutes; default 24h).
CART_ABANDONED_AFTER_MIN=1440
# Per-line quantity cap.
CART_MAX_QTY_PER_LINE=99

# ---- Payments ----
# HMAC secret the MOCK gateway signs/verifies webhooks with (set a strong value in prod).
PAYMENTS_MOCK_SECRET=mock-secret
# Reconciliation sweep cadence and grace window (minutes).
PAYMENTS_RECONCILE_INTERVAL_MIN=5
PAYMENTS_RECONCILE_AFTER_MIN=10

# ---- Seeding (optional; used by `npm run seed`) ----
# First admin account. The seed is skipped if ADMIN_PASSWORD is unset.
ADMIN_EMAIL=admin@buyhat.local
ADMIN_PASSWORD=