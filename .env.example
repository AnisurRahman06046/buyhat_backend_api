# ============================================================
# BuyHat Backend — Environment Variables
# Copy to `.env` and adjust. Never commit the real `.env`.
# ============================================================

# ---- App ----
NODE_ENV=development
PORT=3000
APP_NAME=BuyHat
API_PREFIX=api
API_VERSION=1
# Comma-separated list. Use * to allow all (dev only).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
SWAGGER_ENABLED=true

# ---- Logging ----
# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# ---- Database (PostgreSQL) ----
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=buyhat
DB_PASSWORD=buyhat_password
DB_NAME=buyhat
DB_SSL=false
# Auto-create tables from entities (DEV ONLY — never true in production).
DB_SYNCHRONIZE=false
# Run pending migrations automatically on boot.
DB_MIGRATIONS_RUN=false
DB_LOGGING=false
# Optional: single connection string overrides the discrete vars above.
# DATABASE_URL=postgresql://buyhat:buyhat_password@localhost:5432/buyhat

# ---- Redis (cache + BullMQ) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=buyhat:

# ---- JWT ----
JWT_ACCESS_SECRET=replace_with_long_random_access_secret
JWT_ACCESS_TTL=900s
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret
JWT_REFRESH_TTL=7d

# ---- Rate limiting (@nestjs/throttler v6 — TTL in milliseconds) ----
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# ---- Object storage (S3 / MinIO) ----
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=buyhat-media
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_URL=http://localhost:9000/buyhat-media
